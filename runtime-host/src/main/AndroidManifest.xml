<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RuntimeHostApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KirokuRuntime"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The runtime service is exported so independent host applications can bind to it.
            Access is enforced at call time in RuntimeHostService:
              * callers signed with the runtime's certificate are always allowed;
              * other callers must be listed in the runtime's client allow-list.
            See docs/security.md for why a signature-level android:permission alone is not used.
        -->
        <service
            android:name=".service.RuntimeHostService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.kiroku.runtime.host.BIND_RUNTIME" />
            </intent-filter>
        </service>
    </application>

</manifest>
